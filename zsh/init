export EDITOR=nvim

path=(
  ~/.local/bin(N-/)
  ~/.orbstack/bin(N-/)
  $DOTFILES_PATH/bin(N-/)
  $path
)
cdpath=($cdpath ~/Projects ~/code)

fpath=($DOTFILES_PATH/zsh/functions $fpath)

source $DOTFILES_PATH/zsh/homebrew
source $DOTFILES_PATH/zsh/prompt
source $DOTFILES_PATH/zsh/aliases
source $DOTFILES_PATH/vim/init
source $DOTFILES_PATH/tmux/init

HISTFILE=$DOTFILES_PATH/.history
HISTSIZE=10000
SAVEHIST=10000
setopt sharehistory
setopt incappendhistory

setopt autocd autopushd pushdignoredups nomatch prompt_subst
unsetopt beep extendedglob notify
bindkey -e

autoload -Uz compinit
compinit

# make autocomplete case-insensitive
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

autoload gpr

if (( $+commands[mise] )); then eval "$(mise activate zsh)"; fi

if [ -f ~/.init-dotfiles ]; then source ~/.init-dotfiles; fi

# MOTD
# brew tap daviderestivo/fortune-mod
# brew install fortune-mod --with-offensive
(( $+commands[fortune] )) && fortune -as
